# Copy to .env.local and fill in your project database credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yp666
MYSQL_USER=yp666_app
MYSQL_PASSWORD=
MYSQL_SSL_MODE=VERIFY_CA
MYSQL_SSL_CA=certs/mysql-ca.pem

# These credentials create the initial administrator only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Local application addresses
PORT=3001
HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# local: development; slider: self-hosted lightweight puzzle; turnstile: third-party verification.
CAPTCHA_PROVIDER=local
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set only when the API is behind a reverse proxy on the same machine.
TRUST_PROXY=
