# Copy to .env.local and fill in your project database credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yp666
MYSQL_USER=yp666_app
MYSQL_PASSWORD=
MYSQL_SSL_CA=certs/mysql-ca.pem
# Optional verified DNS identity for a database reached through a tunnel.
MYSQL_SSL_SERVERNAME=
# For a legacy certificate without DNS SAN: trusted SHA-256 certificate pin.
# Obtain the public certificate through a trusted channel, never from an unverified connection.
MYSQL_SSL_SERVER_FINGERPRINT=

# These credentials create the initial administrator only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Production-only administrator page prefix. Generate with:
# node deploy/render-admin-route.mjs --generate
# Keep the actual value in the ignored server configuration, never in Git.
ADMIN_BASE_PATH=

# Local application addresses
PORT=3001
HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# local: development; slider: self-hosted lightweight puzzle; turnstile: third-party verification.
CAPTCHA_PROVIDER=local
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set only when the API is behind a reverse proxy on the same machine.
TRUST_PROXY=

# Optional full path to ffprobe; defaults to the executable on PATH.
FFPROBE_PATH=
