{
  "name": "@yp666/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently -k -n types,server \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"tsx watch --clear-screen=false dist/main.js\"",
    "build": "node scripts/prisma.mjs generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/db-push.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-mariadb": "6.19.0",
    "@prisma/client": "6.19.0",
    "@yp666/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "mariadb": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.2",
    "concurrently": "^9.2.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
